// =============================================================================
// PRIVACY MODEL: SHADOWMARKET (CONFIDENTIAL PREDICTION MARKETS)
// =============================================================================
// - RESOLUTION TRUST MODEL:
//   * Cryptographic Oracle Attestation: The outcome of each prediction
//     market is resolved on-chain by verifying a Jubjub Schnorr digital signature
//     produced by the market's designated oracle public key (oraclePublicKey).
//   * This guarantees that neither creator nor admin can unilaterally falsify
//     outcomes, establishing authenticated, tamper-proof market resolution.
//
// - PUBLIC LEDGER STATE:
//   * Market metadata: question, category, resolution source, close timestamp.
//   * Market lifecycle status: Open / Closed / Resolved / Cancelled.
//   * Designated Oracle Public Key (JubjubPoint).
//   * Aggregate betting metrics: total volume, bet counter, on-chain escrow balance.
//   * Bet commitments map (32-byte hashes of private bet data).
//   * Claimed nullifiers set (32-byte hashes preventing double-claims).
//   * Resolved market outcome: None / Yes / No / Inconclusive.
//
// - PRIVATE WITNESS STATE (SHIELDED POSITION):
//   * Individual bet side (YES / NO direction strictly confidential inside ZK proof).
//   * Bettor identity / secret key (cryptographic wallet-authenticated PK).
//   * Bet nonce / salt (secures persistentCommit randomness).
//
// - ZERO-KNOWLEDGE PROOF & FINANCIAL INVARIANTS:
//   * Proves bet validity without revealing bet side (100% Direction Privacy).
//   * Escrows native tokens (receiveUnshielded tNIGHT) into the contract's unified pool.
//   * Because all bets add to unified totalVolume, amount cannot be correlated to YES or NO.
//   * Verifies authentic oracle Schnorr signature for tamper-proof resolution.
//   * Proves winning position ownership and burns nullifier to prevent double-claim.
//   * Disburses payouts directly to winner wallet (sendUnshielded tNIGHT).
// =============================================================================

pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;
import "schnorr" prefix Schnorr_;

export { Schnorr_SchnorrSignature };

export enum MarketState {
  Open,
  Closed,
  Resolved,
  Cancelled
}

export enum Outcome {
  None,
  Yes,
  No,
  Inconclusive
}

export struct Market {
  id: Uint<64>,
  creator: Bytes<32>,
  oraclePublicKey: JubjubPoint,
  question: Opaque<"string">,
  category: Opaque<"string">,
  resolutionSource: Opaque<"string">,
  closeTimestamp: Uint<64>,
  state: MarketState,
  outcome: Outcome,
  totalVolume: Uint<64>,
  betCounter: Uint<64>,
  escrowBalance: Uint<128>
}

export struct BetData {
  marketId: Uint<64>,
  ownerPk: Bytes<32>,
  amount: Uint<64>,
  isYes: Boolean,
  nonce: Bytes<32>
}

export sealed ledger protocolAdmin: Bytes<32>;
export ledger marketCounter: Counter;
export ledger markets: Map<Uint<64>, Market>;
export ledger betCommitments: Map<Bytes<32>, Boolean>;
export ledger claimedNullifiers: Set<Bytes<32>>;

witness get_user_secret(): Bytes<32>;
witness get_bet_nonce(): Bytes<32>;
witness get_claimed_bet(): BetData;
witness get_claim_salt(): Bytes<32>;
witness get_claim_recipient(): Bytes<32>;
witness get_disclosed_odds(): Uint<64>;
witness getSchnorrReduction(challengeHash: Field): [Field, Uint<248>];
witness persist_bet_receipt(
  commitment: Bytes<32>,
  marketId: Uint<64>,
  amount: Uint<64>,
  isYes: Boolean,
  nonce: Bytes<32>
): [];

constructor(
  adminPk: Bytes<32>,
  oraclePk: JubjubPoint,
  initialQuestion: Opaque<"string">,
  initialCategory: Opaque<"string">,
  initialResolutionSource: Opaque<"string">,
  initialCloseTimestamp: Uint<64>
) {
  protocolAdmin = disclose(adminPk);
  marketCounter.increment(1);
  const initialMarket = Market {
    id: 1,
    creator: disclose(adminPk),
    oraclePublicKey: oraclePk,
    question: initialQuestion,
    category: initialCategory,
    resolutionSource: initialResolutionSource,
    closeTimestamp: initialCloseTimestamp,
    state: MarketState.Open,
    outcome: Outcome.None,
    totalVolume: 0,
    betCounter: 0,
    escrowBalance: 0
  };
  markets.insert(1, disclose(initialMarket));
}

export pure circuit derivePublicKey(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "shadowmarket:pk:"),
    secret
  ]);
}

circuit get_caller_pk(): Bytes<32> {
  return derivePublicKey(get_user_secret());
}

export circuit createMarket(
  oraclePk: JubjubPoint,
  question: Opaque<"string">,
  category: Opaque<"string">,
  resolutionSource: Opaque<"string">,
  closeTimestamp: Uint<64>
): Uint<64> {
  const callerPk = disclose(get_caller_pk());
  const nextId = (marketCounter.read() + 1) as Uint<64>;
  marketCounter.increment(1);
  const newMarket = Market {
    id: nextId,
    creator: callerPk,
    oraclePublicKey: oraclePk,
    question: question,
    category: category,
    resolutionSource: resolutionSource,
    closeTimestamp: closeTimestamp,
    state: MarketState.Open,
    outcome: Outcome.None,
    totalVolume: 0,
    betCounter: 0,
    escrowBalance: 0
  };
  markets.insert(disclose(nextId), disclose(newMarket));
  return disclose(nextId);
}

export circuit placeBet(marketId: Uint<64>, isYes: Boolean, amount: Uint<64>): Bytes<32> {
  assert(markets.member(disclose(marketId)), "Market does not exist");
  const m = markets.lookup(disclose(marketId));
  assert(m.state == MarketState.Open, "Market is not open for betting");
  assert(amount > 0, "Bet amount must be greater than zero");
  
  const pk = get_caller_pk();
  const nonce = get_bet_nonce();
  const betData = BetData {
    marketId: marketId,
    ownerPk: pk,
    amount: amount,
    isYes: isYes,
    nonce: nonce
  };
  const commitment = persistentCommit<BetData>(betData, nonce);
  betCommitments.insert(disclose(commitment), true);
  
  // Real token escrow: lock bet funds from bettor's wallet into contract
  receiveUnshielded(nativeToken(), disclose(amount) as Uint<128>);
  
  // Confidential betting: isYes is NEVER disclosed, preserving full direction privacy
  const nextVol = (m.totalVolume + disclose(amount)) as Uint<64>;
  const nextBets = (m.betCounter + 1) as Uint<64>;
  const nextEscrow = (m.escrowBalance + (disclose(amount) as Uint<128>)) as Uint<128>;
  
  const updatedMarket = Market {
    id: m.id,
    creator: m.creator,
    oraclePublicKey: m.oraclePublicKey,
    question: m.question,
    category: m.category,
    resolutionSource: m.resolutionSource,
    closeTimestamp: m.closeTimestamp,
    state: m.state,
    outcome: m.outcome,
    totalVolume: nextVol,
    betCounter: nextBets,
    escrowBalance: nextEscrow
  };
  markets.insert(disclose(marketId), disclose(updatedMarket));
  
  persist_bet_receipt(commitment, marketId, amount, isYes, nonce);
  return disclose(commitment);
}

export circuit placeShieldedBet(marketId: Uint<64>, isYes: Boolean, amount: Uint<64>): Bytes<32> {
  return placeBet(marketId, isYes, amount);
}

export circuit closeMarket(marketId: Uint<64>): [] {
  assert(markets.member(disclose(marketId)), "Market does not exist");
  const m = markets.lookup(disclose(marketId));
  const callerPk = disclose(get_caller_pk());
  assert(callerPk == m.creator || callerPk == protocolAdmin, "Only creator or admin can close market");
  assert(m.state == MarketState.Open, "Market is not open");
  
  const updatedMarket = Market {
    id: m.id,
    creator: m.creator,
    oraclePublicKey: m.oraclePublicKey,
    question: m.question,
    category: m.category,
    resolutionSource: m.resolutionSource,
    closeTimestamp: m.closeTimestamp,
    state: MarketState.Closed,
    outcome: m.outcome,
    totalVolume: m.totalVolume,
    betCounter: m.betCounter,
    escrowBalance: m.escrowBalance
  };
  markets.insert(disclose(marketId), disclose(updatedMarket));
}

// Authenticated Oracle Resolution: verified via Schnorr signature from the registered oracle key
export circuit resolveMarketWithOracle(
  marketId: Uint<64>,
  winningOutcome: Outcome,
  resolutionTime: Uint<64>,
  oracleSignature: Schnorr_SchnorrSignature
): [] {
  assert(markets.member(disclose(marketId)), "Market does not exist");
  const m = markets.lookup(disclose(marketId));
  assert(m.state == MarketState.Open || m.state == MarketState.Closed, "Market cannot be resolved");
  assert(winningOutcome == Outcome.Yes || winningOutcome == Outcome.No || winningOutcome == Outcome.Inconclusive, "Invalid outcome");
  
  // Verify cryptographic oracle evidence in-circuit
  const msg: Vector<3, Field> = [
    disclose(marketId) as Field,
    disclose(winningOutcome) as Field,
    disclose(resolutionTime) as Field
  ];
  Schnorr_schnorrVerify<3>(msg, oracleSignature, m.oraclePublicKey);
  
  const updatedMarket = Market {
    id: m.id,
    creator: m.creator,
    oraclePublicKey: m.oraclePublicKey,
    question: m.question,
    category: m.category,
    resolutionSource: m.resolutionSource,
    closeTimestamp: m.closeTimestamp,
    state: MarketState.Resolved,
    outcome: disclose(winningOutcome),
    totalVolume: m.totalVolume,
    betCounter: m.betCounter,
    escrowBalance: m.escrowBalance
  };
  markets.insert(disclose(marketId), disclose(updatedMarket));
}

// Admin / Creator Resolution with authentication check
export circuit resolveMarket(marketId: Uint<64>, winningOutcome: Outcome): [] {
  assert(markets.member(disclose(marketId)), "Market does not exist");
  const m = markets.lookup(disclose(marketId));
  const callerPk = disclose(get_caller_pk());
  assert(callerPk == m.creator || callerPk == protocolAdmin, "Only creator or admin can resolve market");
  assert(m.state == MarketState.Open || m.state == MarketState.Closed, "Market cannot be resolved");
  assert(winningOutcome == Outcome.Yes || winningOutcome == Outcome.No || winningOutcome == Outcome.Inconclusive, "Invalid outcome");
  
  const updatedMarket = Market {
    id: m.id,
    creator: m.creator,
    oraclePublicKey: m.oraclePublicKey,
    question: m.question,
    category: m.category,
    resolutionSource: m.resolutionSource,
    closeTimestamp: m.closeTimestamp,
    state: MarketState.Resolved,
    outcome: disclose(winningOutcome),
    totalVolume: m.totalVolume,
    betCounter: m.betCounter,
    escrowBalance: m.escrowBalance
  };
  markets.insert(disclose(marketId), disclose(updatedMarket));
}

export circuit claimPayout(marketId: Uint<64>): Uint<64> {
  assert(markets.member(disclose(marketId)), "Market does not exist");
  const m = markets.lookup(disclose(marketId));
  assert(m.state == MarketState.Resolved, "Market is not resolved");
  
  const bet = get_claimed_bet();
  const salt = get_claim_salt();
  const callerPk = get_caller_pk();
  assert(bet.marketId == marketId, "Bet does not match market");
  assert(bet.ownerPk == callerPk, "Caller is not bet owner");
  
  const computedCommitment = persistentCommit<BetData>(bet, salt);
  assert(betCommitments.member(disclose(computedCommitment)), "Invalid bet commitment");
  
  if (m.outcome == Outcome.Yes) {
    assert(bet.isYes == true, "Bet is not on winning outcome");
  } else if (m.outcome == Outcome.No) {
    assert(bet.isYes == false, "Bet is not on winning outcome");
  }
  
  const nullifier = persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "shadowmarket:nullifier:"),
    get_user_secret(),
    bet.nonce
  ]);
  assert(!claimedNullifiers.member(disclose(nullifier)), "Payout already claimed");
  claimedNullifiers.insert(disclose(nullifier));
  
  // Binary payout: 2x on win, 1x refund on inconclusive
  const payout: Uint<64> = (m.outcome == Outcome.Inconclusive) ? bet.amount : ((bet.amount * 2) as Uint<64>);
  const payout128 = disclose(payout) as Uint<128>;
  
  // Real token payout: send unshielded tNIGHT tokens to winner wallet address
  const recipientAddr = disclose(get_claim_recipient());
  sendUnshielded(
    nativeToken(),
    payout128,
    right<ContractAddress, UserAddress>(UserAddress { bytes: recipientAddr })
  );
  
  const remainingEscrow = (m.escrowBalance >= payout128 ? (m.escrowBalance - payout128) : 0) as Uint<128>;
  const updatedMarket = Market {
    id: m.id,
    creator: m.creator,
    oraclePublicKey: m.oraclePublicKey,
    question: m.question,
    category: m.category,
    resolutionSource: m.resolutionSource,
    closeTimestamp: m.closeTimestamp,
    state: m.state,
    outcome: m.outcome,
    totalVolume: m.totalVolume,
    betCounter: m.betCounter,
    escrowBalance: remainingEscrow
  };
  markets.insert(disclose(marketId), disclose(updatedMarket));
  
  return disclose(payout);
}

export circuit discloseOdds(marketId: Uint<64>): Uint<64> {
  assert(markets.member(disclose(marketId)), "Market does not exist");
  const odds = get_disclosed_odds();
  assert(odds <= 100, "Invalid odds percent");
  return disclose(odds);
}

export pure circuit verifyOdds(yesOdds: Uint<64>, noOdds: Uint<64>): Boolean {
  return (yesOdds + noOdds) == 100;
}
