{
  "name": "shadowmarket",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Privacy-native prediction markets on the Midnight Network",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "compile": "compact compile contracts/shadowmarket.compact managed/shadowmarket",
    "compile:skip-zk": "compact compile --skip-zk contracts/shadowmarket.compact managed/shadowmarket",
    "deploy": "tsx deploy/deploy.ts",
    "deploy:preprod": "tsx deploy/deploy.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:live": "tsx scripts/test-e2e-live.ts",
    "test:create-market": "tsx scripts/test-create-market.ts",
    "record:demo": "tsx scripts/record-demo.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
